// SUEZ TRADING INTERNATIONALE LIMITED — commerce + inventory schema
//
// Postgres (Neon). Money is stored as integer kobo to avoid floating point
// drift: 1 NGN = 100 kobo, so ₦9,800.00 is 980000.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  ABANDONED
  REFUNDED
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum StockReason {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
  DAMAGE
  CANCELLED_ORDER
}

enum OrderEventType {
  CREATED
  PAYMENT_PAID
  STATUS_CHANGED
  NOTE
  WEBHOOK
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum CouponType {
  PERCENT
  FIXED
}

// ---------------------------------------------------------------- staff / auth

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(STAFF)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stockMovements StockMovement[]
  orderEvents    OrderEvent[]

  @@index([email])
  @@index([active])
}

// ---------------------------------------------------------------- catalogue

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  image       String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
  @@index([active, sortOrder])
}

model Product {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  sku              String  @unique
  shortDescription String?
  description      String? @db.Text
  brand            String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // pricing, in kobo
  price          Int
  compareAtPrice Int?
  costPrice      Int?

  unit        String @default("each")
  minOrderQty Int    @default(1)

  // inventory
  stock             Int     @default(0)
  lowStockThreshold Int     @default(10)
  trackInventory    Boolean @default(true)
  allowBackorder    Boolean @default(false)
  warehouse         String?

  // merchandising
  featured      Boolean       @default(false)
  status        ProductStatus @default(ACTIVE)
  requiresQuote Boolean       @default(false)
  weightKg      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images         ProductImage[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([slug])
  @@index([categoryId])
  @@index([status, featured])
  @@index([status, createdAt])
  @@index([status, price])
  @@index([sku])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  /// Cloudinary public_id (or R2 object key), kept so the file can be deleted
  /// when the image is replaced or the product is removed.
  storageId String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// ---------------------------------------------------------------- orders

model Order {
  id        String @id @default(cuid())
  reference String @unique // also the Paystack reference

  customerName  String
  customerEmail String
  customerPhone String

  deliveryMethod DeliveryMethod @default(DELIVERY)
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String         @default("Nigeria")

  subtotal Int
  shipping Int    @default(0)
  discount Int    @default(0)
  total    Int
  currency String @default("NGN")

  couponCode String?
  coupon     Coupon? @relation(fields: [couponCode], references: [code], onDelete: SetNull)

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  paystackAccessCode String?
  paymentChannel     String?
  paidAt             DateTime?
  paymentRaw         Json?

  /// Guards against double-decrementing stock when the Paystack webhook and
  /// the browser callback race each other.
  stockCommitted Boolean @default(false)
  notes          String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  events         OrderEvent[]
  stockMovements StockMovement[]

  @@index([reference])
  @@index([customerEmail])
  @@index([paymentStatus, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([paidAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Denormalised so a receipt survives later catalogue edits.
  name      String
  sku       String
  unit      String @default("each")
  unitPrice Int
  quantity  Int
  lineTotal Int

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type    OrderEventType
  message String         @db.Text

  actorId String?
  actor   AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// ---------------------------------------------------------------- inventory ledger

model StockMovement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  delta   Int // negative for sales and write-offs, positive for receipts
  balance Int // resulting stock level, so the ledger reconciles on its own
  reason  StockReason
  note    String?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  actorId String?
  actor   AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([orderId])
}

// ---------------------------------------------------------------- enquiries & ops

model Enquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  service     String?
  subject     String?
  message     String        @db.Text
  status      EnquiryStatus @default(NEW)
  handledNote String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

model Coupon {
  code        String     @id
  type        CouponType @default(PERCENT)
  value       Int // whole percent, or kobo for a fixed amount
  minSubtotal Int        @default(0)
  maxUses     Int?
  usedCount   Int        @default(0)
  expiresAt   DateTime?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())

  orders Order[]

  @@index([active])
}

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
