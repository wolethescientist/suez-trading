# ============================================================ database (Neon)
# Local development runs against the Docker Postgres started by:
#   docker start suez-postgres
#
# For production, create a project at https://console.neon.tech and paste the
# POOLED connection string here — the host contains "-pooler". Example:
#   DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/sueztrading?sslmode=require"
#
# Neon also gives an unpooled/direct string. Prisma migrations want the direct
# one; the app wants the pooled one.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/sueztrading?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/sueztrading?sslmode=require"

# ============================================================ admin auth
# Any random 32+ character string. Regenerate for production with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ============================================================ paystack
# https://dashboard.paystack.com/#/settings/developers
# Test keys start with sk_test_ / pk_test_. The app runs without them, but
# checkout will report that payments are not configured.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ============================================================ image storage
# Cloudinary handles upload, CDN delivery and on-the-fly resizing/format.
# Find these on the Cloudinary dashboard under Product Environment Credentials.
# Leave blank in development and uploads fall back to writing into public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Everything uploaded is filed under this folder in your Cloudinary media library.
CLOUDINARY_FOLDER="suez-trading/products"

# ============================================================ app
# Used to build the Paystack callback URL. Must match the deployed origin.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed credentials for the first owner account (npm run seed)
SEED_ADMIN_EMAIL="admin@sueztrading.com"
SEED_ADMIN_PASSWORD=""

# ============================================================ demo mode
# "true"  simulate payments (stakeholder demos, no Paystack account needed)
# "false" always use real Paystack
# unset   simulate only when PAYSTACK_SECRET_KEY is missing
DEMO_PAYMENTS="true"
